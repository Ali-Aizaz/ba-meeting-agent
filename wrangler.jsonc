{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ba-meeting-agent",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-26",
  "tsconfig": "tsconfig.json",
  "containers": [
    {
      "class_name": "BaContainer",
      // One image and one size: "instance_type": "standard-1", "max_instances": 1
      "scheduling_policy": "durable_object",
      "observability": {
        "logs": {
          "enabled": true
        }
      },
      "images": {
        "bot": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BA_CONTAINER",
        "class_name": "BaContainer"
      }
    ]
  },
  "exports": {
    "BaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
